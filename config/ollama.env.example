# Ollama 服务端环境变量
# 用法：
#   1. 复制此文件为 ollama.env
#   2. 在脚本中 source / dot-source 使用；或
#   3. 写入系统环境变量：winget 配置 / 系统属性 → 高级 → 环境变量
#      PowerShell: [Environment]::SetEnvironmentVariable("KEY","VALUE","User")

# ------------------------------------------------------------
# 闲置自动卸载（核心节能开关）
# ------------------------------------------------------------
# 数值后缀：s(秒) / m(分) / h(时)
# 5m = 5 分钟无 API 调用则从显存卸载模型，VRAM 归零
# 设为 0 表示立即卸载（不推荐，每次会重新加载慢）
# 设为 -1 或 0s 表示永远不卸载（等同常驻）
#
# ⚠️ keep_alive 是 **per-model** 的：可以在请求里单独覆盖某个模型的存活时间。
#    提取器/摘要模型是冷路径（每 5 轮才跑一次），
#    在 Mem0 / AstrBot 调用它时带上 "keep_alive": "30s" 即可让它提前卸载，
#    语音交互时就不会和 TTS 抢显存。详见 docs/service-lifecycle.md
OLLAMA_KEEP_ALIVE=5m

# ------------------------------------------------------------
# 上下文窗口
# ------------------------------------------------------------
# 影响 KV cache 占用的显存和首次加载时间
# ⚠️ Ollama 会按显存自动选 num_ctx：显存 < 24 GiB 时默认只有 4096！
#    上下文太小会导致机器人"忘了"刚说过的话，必须显式设置
# 4096  ~0.35G KV cache (q8_0，省显存但记忆短)
# 8192  ~0.4G  KV cache (推荐)
# 16384 ~0.8G  KV cache (需更宽松的显存)
# 32768 ~1.6G  KV cache (配合 q8_0 量化仍可接受)
OLLAMA_CONTEXT_LENGTH=8192

# ------------------------------------------------------------
# KV cache 量化 + Flash Attention（Qwen3.5 必开）
# ------------------------------------------------------------
# KV cache 从 f16 降到 q8_0 → 显存约减半
# Flash Attention → 同样显存下能装更长上下文，且推理更快
# ⚠️ 这两个不设，8K 上下文的 KV 会从 ~0.4GB 涨到 ~0.7GB
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_FLASH_ATTENTION=1

# ------------------------------------------------------------
# 并行
# ------------------------------------------------------------
# 同时处理多少个请求
# 多用户场景可加大；单用户保持 1
OLLAMA_NUM_PARALLEL=1

# ------------------------------------------------------------
# 服务监听
# ------------------------------------------------------------
OLLAMA_HOST=127.0.0.1:11434
# ⚠️⚠️ 危险：Ollama **没有任何鉴权**。公网上已有 17.5 万个裸奔实例被扫描。
#    切勿绑定 0.0.0.0 暴露公网，局域网共享请走 SSH 隧道或反向代理加认证。
# OLLAMA_HOST=0.0.0.0:11434

# ------------------------------------------------------------
# GPU 设置
# ------------------------------------------------------------
# 默认使用所有可见 GPU；多卡环境可指定
# CUDA_VISIBLE_DEVICES=0
# 多 GPU 时各模型分片（一般不需要，单卡 9B 已能跑）
# OLLAMA_NUM_GPU=999
#
# ⚠️ 显存预算（2026-10-24 在本机实测）：
#   这台机器的桌面程序常驻占约 4 GB 显存（Chrome / ToDesk / QQLive / wallpaper64 /
#   steamwebhelper / NVIDIA Overlay），所以 Ollama 实际可用显存是 ~12 GB，不是 16 GB。
#   文字模式约 11 - 14.6 GB（装得下），语音峰值 ~12.5 - 20 GB（会 OOM，必须先降级）。
#   降级顺序见 docs/hardware-budget.md —— 第一步是关后台程序（零成本，-3 GB）。

# ------------------------------------------------------------
# 版本要求
# ------------------------------------------------------------
# ≥ v0.17.5 —— 修 Qwen3.5 的 GPU/CPU 分割崩溃与重复循环 bug（必须）
# ≥ v0.31.2 —— 多模态稳定性（推荐）
# v0.40.10（2026-10-23 发布）—— 上游当前最新版，本机直接装这个
#   * 官方硬件支持列表已含 compute capability 12.0（GeForce RTX 50xx，含 RTX 5060 Ti），
#     要求驱动 ≥ 550 —— 本机驱动 610.88 / CUDA 13.3 ✅
#   * v0.40.9 的原生语音生成（Phonon）仅支持 Apple Silicon，本机用不到；
#     TTS 必须外挂独立进程（llama.cpp-omni + VoxCPM2 / vLLM-Omni / transformers）
# 查看版本：ollama --version
